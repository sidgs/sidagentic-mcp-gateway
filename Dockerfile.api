# SAMI MCP Gateway API image: HTTP path prefix + dashboard built under the same base path.
#
# Build: docker build -f Dockerfile.api -t sami-mcpgateway-api .
#
# Dashboard: VITE_DASHBOARD_BASE=/ai/v1/sami-mcp-gateway
# Server:     HTTP_PATH_PREFIX=/ai/v1/sami-mcp-gateway

FROM node:20-bookworm-slim AS dashboard-builder

WORKDIR /src/web/dashboard
COPY web/dashboard/package.json web/dashboard/package-lock.json ./
RUN npm ci
COPY web/dashboard/ ./
COPY assets /src/assets

ARG VITE_DASHBOARD_BASE=/ai/v1/sami-mcp-gateway
ENV VITE_DASHBOARD_BASE=$VITE_DASHBOARD_BASE

RUN npm run build

FROM golang:1.24.3-bookworm AS builder

ARG VERSION=dev

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN rm -rf internal/dashboardui/dist
COPY --from=dashboard-builder /src/web/dashboard/dist ./internal/dashboardui/dist

RUN CGO_ENABLED=0 go build -trimpath \
	-ldflags="-s -w -X github.com/mcpjungle/mcpjungle/pkg/version.Version=${VERSION}" \
	-o /sami-mcp-gateway .

FROM gcr.io/distroless/base

ENV HTTP_PATH_PREFIX=/ai/v1/sami-mcp-gateway

COPY --from=builder /sami-mcp-gateway /sami-mcp-gateway

EXPOSE 8080
ENTRYPOINT ["/sami-mcp-gateway"]
CMD ["start"]
