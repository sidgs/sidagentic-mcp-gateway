# SAMI MCP Gateway API image: HTTP path prefix + dashboard built under the same base path.
# Runtime includes uv/uvx (Astral base) and Node/npx (NodeSource) for stdio MCP commands.
#
# Build: docker build -f Dockerfile.api -t sami-mcpgateway-api .
#
# Dashboard: VITE_DASHBOARD_BASE=/ai/v1/sami-mcp-gateway
# Server:     HTTP_PATH_PREFIX=/ai/v1/sami-mcp-gateway

FROM node:20-bookworm-slim AS dashboard-builder

WORKDIR /src/web/dashboard
COPY web/dashboard/package.json web/dashboard/package-lock.json ./
RUN npm ci
COPY web/dashboard/ ./
# Vite resolves @repo-assets to /src/assets (repo-root ../../assets). The dir may be empty if no bundled images.
RUN mkdir -p /src/assets

ARG VITE_DASHBOARD_BASE=/
ENV VITE_DASHBOARD_BASE=$VITE_DASHBOARD_BASE

RUN npm run build

FROM golang:1.24.3-bookworm AS builder

ARG VERSION=dev

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN rm -rf internal/dashboardui/dist
COPY --from=dashboard-builder /src/web/dashboard/dist ./internal/dashboardui/dist

RUN CGO_ENABLED=0 go build -trimpath \
	-ldflags="-s -w -X sami.io/mcpgateway/pkg/version.Version=${VERSION}" \
	-o /sami-mcp-gateway .

# Runtime: uv + uvx (stdio MCP servers); Node for npx. Not distroless — those tools need a shell and libs.
FROM ghcr.io/astral-sh/uv:debian

RUN apt-get update \
	&& apt-get install -y --no-install-recommends curl gnupg \
	&& curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
	&& apt-get install -y --no-install-recommends nodejs \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*

ENV HTTP_PATH_PREFIX=/api/v1/sami-mcp-gateway
ENV DEFAULT_TENANT_ID=sami

COPY --from=builder /sami-mcp-gateway /sami-mcp-gateway

EXPOSE 8080
ENTRYPOINT ["/sami-mcp-gateway"]
CMD ["start"]
